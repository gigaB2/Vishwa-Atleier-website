# =============================================================================
# Vishwa Atelier Management Suite — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` or `.env.local` to override default settings locally.
# NEVER commit your actual `.env` file or service_role secret keys to Git.
# =============================================================================

# --- 1. Supabase Cloud Configuration (Client-Safe) ---
# Your Supabase Project URL (found in Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Project 'anon' / 'public' API Key (client-safe)
# IMPORTANT: Never place your 'service_role' key here!
SUPABASE_ANON_KEY=your-anon-public-key-here

# --- 2. AI Features (Optional) ---
# Google Gemini API key for invoice/challan OCR and yarn slip scanning
GEMINI_API_KEY=your-gemini-api-key-here

# --- 3. Database Administration (CLI / Migration Ops Only) ---
# Used ONLY for running migration scripts via psql or Supabase CLI.
# Do NOT deploy this to any web server or include in client-side bundles.
# DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
